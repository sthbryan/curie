{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": true,
  "sortPackageJson": false,
  "sortTailwindcss": false,
  "ignorePatterns": [
    "*.md",
    "*.yml",
    "*.yaml",
    "*.sh",
    ".github/**",
    ".vscode/**",
    "assets/**",
    "public/**",
    "src-tauri/**",
    "dist/**",
    "coverage/**"
  ]
}
