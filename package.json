    "@zovaris/sephiro": "0.14.1",
    "cnfast": "0.2.0",
    "lucide-react": "1.61.0",
    "preact": "11.0.2",
    "react-if": "4.1.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "thinking-orbs": "^0.3.2",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
